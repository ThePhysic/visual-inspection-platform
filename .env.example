# Optional. No .env is required for full Compose execution.
# The web host port is the only full-container setting below.
WEB_PORT=8080

# Native pnpm development settings. Full Compose sets internal connections and
# storage explicitly, so native localhost/Windows paths never enter containers.
API_HOST=127.0.0.1
API_PORT=3001

# Native dependency override (compose.dev.yaml) binds ports to loopback only.
MONGODB_PORT=27017
MONGODB_URI=mongodb://127.0.0.1:27017/visual_inspection

# Relative paths resolve from the repository root; absolute paths are supported.
# Keep image storage outside tracked source. The default is Git-ignored.
ASSET_STORAGE_DIR=.data/images

# Integration tests create/drop an isolated random database on this server.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# API dispatch and worker must use the same Redis instance.
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379
# Integration tests use unique queue names; no FLUSHDB is performed.
REDIS_TEST_URL=redis://127.0.0.1:6379

# Optional browser-test Redis override. Defaults to REDIS_TEST_URL on database 15.
# Reserve this database for browser tests; do not point it at a production queue.
# E2E_REDIS_URL=redis://127.0.0.1:6379/15

# Full Compose internal values (provided in compose.yaml, not required here):
# API_HOST=0.0.0.0, API_PORT=3001
# MONGODB_URI=mongodb://mongodb:27017/visual_inspection
# REDIS_URL=redis://redis:6379, ASSET_STORAGE_DIR=/data/images
# Optional host browser smoke-test target; not embedded in the React build.
# CONTAINER_BASE_URL=http://127.0.0.1:8080

# Optional native worker heartbeat (omit normally). Compose uses a container-local
# /tmp/vip-worker-health.json, never the read-only canonical image volume.
# WORKER_HEALTH_FILE=.data/worker-health.json

# Optional native operator listeners, bound strictly to 127.0.0.1.
# Separate process registries; never embedded in the browser or proxied by nginx.
# API_OPERATOR_PORT=9464
# WORKER_OPERATOR_PORT=9465
# Full Compose enables these inside containers without publishing either port.
