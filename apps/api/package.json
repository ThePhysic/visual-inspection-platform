{
  "name": "@vip/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --include \"../../packages/contracts/dist/**/*.js\" --include \"../../packages/backend/dist/**/*.js\" src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.4",
    "@fastify/type-provider-typebox": "6.3.0",
    "@vip/contracts": "workspace:*",
    "fastify": "5.12.7",
    "mongoose": "9.11.2",
    "sharp": "0.35.5",
    "typebox": "1.4.2",
    "@vip/backend": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "bullmq": "5.81.5",
    "ioredis": "5.11.1"
  }
}
